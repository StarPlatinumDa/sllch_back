<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vueadmin.system.mapper.FriendMapper">
    <insert id="addFriend" parameterType="Friend">
        insert into friend(`user_id`, `friend_id`, `nickname`, `friend_blacklist`)
        values(#{userId}, #{friendId}, #{nickname}, #{friendBlacklist})
    </insert>

    <delete id="delFriend" parameterType="Friend">
        delete from friend
        where (user_id=#{userId} and friend_id=#{friendId})
        or (user_id=#{friendId} and friend_id=#{userId})
    </delete>

    <update id="updateFriend" parameterType="Map">
        update friend
        <set>
            <if test="friendBlacklist != null">
                friend_blacklist=#{friendBlacklist},
            </if>
            <if test="nickname != null">
                nickname=#{nickname}
            </if>
        </set>
        where user_id=#{userId} and friend_id=#{friendId}
    </update>

    <select id="selectOneFriend" parameterType="Friend" resultType="Friend">
        select * from friend where user_id=#{userId} and friend_id=#{friendId};
    </select>

    <select id="selectFriends" parameterType="Friend" resultType="Friend">
        select * from friend where user_id=#{userId}
    </select>
</mapper>